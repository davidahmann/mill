{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "riskClass": { "type": "string", "enum": ["low", "medium", "high"] },
    "baseRef": { "type": "string", "pattern": "^(?!-)[^\\s]+$" },
    "authority": {
      "type": "object",
      "properties": {
        "productContract": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "required": ["path", "digest"],
          "additionalProperties": false
        },
        "scenarioSet": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "required": ["path", "digest"],
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "required": ["path", "digest"],
          "additionalProperties": false
        },
        "impactManifest": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "required": ["path", "digest"],
          "additionalProperties": false
        }
      },
      "required": ["productContract", "scenarioSet", "policy"],
      "additionalProperties": false
    },
    "contextPaths": {
      "minItems": 1,
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "allowedPaths": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[^*?[\\]\\\\]+(?:\\/\\*\\*)?$"
      }
    },
    "commandIds": {
      "minItems": 1,
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "invariantIds": {
            "default": [],
            "type": "array",
            "items": { "type": "string", "pattern": "^INV-[A-Z0-9][A-Z0-9-]*$" }
          },
          "scenarioIds": {
            "default": [],
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "coverage": {
            "default": "new_behavior",
            "type": "string",
            "enum": ["new_behavior", "preservation", "both"]
          },
          "evidence": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": { "type": "string", "const": "command" },
                  "commandId": { "type": "string", "minLength": 1 }
                },
                "required": ["mode", "commandId"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": { "type": "string", "const": "human" },
                  "attestation": {
                    "type": "object",
                    "properties": {
                      "approvedBy": { "type": "string", "minLength": 1 },
                      "approvedAt": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      },
                      "expiresAt": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      },
                      "statementDigest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "approvedBy",
                      "approvedAt",
                      "expiresAt",
                      "statementDigest"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": ["mode", "attestation"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": { "type": "string", "const": "unsupported" },
                  "reason": { "type": "string", "minLength": 1 }
                },
                "required": ["mode", "reason"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["id", "statement"],
        "additionalProperties": false
      }
    },
    "commit": {
      "type": "object",
      "properties": {
        "message": { "type": "string", "minLength": 1 },
        "authorName": { "type": "string", "minLength": 1 },
        "authorEmail": {
          "type": "string",
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        }
      },
      "required": ["message", "authorName", "authorEmail"],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "deadlineSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10000000
        },
        "retryCount": { "type": "integer", "minimum": 0, "maximum": 1 }
      },
      "required": ["deadlineSeconds", "maxOutputBytes", "retryCount"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "objective",
    "riskClass",
    "baseRef",
    "authority",
    "contextPaths",
    "allowedPaths",
    "commandIds",
    "acceptance",
    "commit",
    "budget"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/davidahmann/mill/schemas/task-packet.schema.json",
  "title": "TaskPacket"
}

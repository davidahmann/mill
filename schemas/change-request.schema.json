{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "repositoryIntelligence": { "type": "boolean", "const": true },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "kind": {
      "type": "string",
      "enum": ["prd", "plan", "bug", "review", "maintenance"]
    },
    "source": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "required": ["path", "digest"],
      "additionalProperties": false
    },
    "productPath": {
      "type": "string",
      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[^*?[\\]\\\\]+(?:\\/\\*\\*)?$"
    },
    "scenariosPath": {
      "type": "string",
      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[^*?[\\]\\\\]+(?:\\/\\*\\*)?$"
    },
    "policyPath": {
      "type": "string",
      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[^*?[\\]\\\\]+(?:\\/\\*\\*)?$"
    },
    "commit": {
      "type": "object",
      "properties": {
        "message": { "type": "string", "minLength": 1 },
        "authorName": { "type": "string", "minLength": 1 },
        "authorEmail": {
          "type": "string",
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        }
      },
      "required": ["message", "authorName", "authorEmail"],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "deadlineSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "maxContextBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10000000
        },
        "retryCount": { "type": "integer", "minimum": 0, "maximum": 1 }
      },
      "required": ["deadlineSeconds", "maxOutputBytes", "retryCount"],
      "additionalProperties": false
    },
    "readyOutcomeId": { "type": "string", "minLength": 1 },
    "tasks": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "outcomeId": {
            "type": "string",
            "pattern": "^OUT-[A-Z0-9][A-Z0-9-]*$"
          },
          "supersedesTaskDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "title": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string", "pattern": "^OUT-[A-Z0-9][A-Z0-9-]*$" }
          },
          "impactPath": {
            "type": "string",
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[^*?[\\]\\\\]+(?:\\/\\*\\*)?$"
          },
          "allowedPaths": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[^*?[\\]\\\\]+(?:\\/\\*\\*)?$"
            }
          },
          "contextPaths": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "attestations": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^ATT-[A-Z0-9][A-Z0-9-]*$"
                },
                "approvedBy": { "type": "string", "minLength": 1 },
                "approvedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "expiresAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "claims": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": ["acceptance", "invariant", "scenario"]
                      },
                      "id": { "type": "string", "minLength": 1 },
                      "digest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      }
                    },
                    "required": ["kind", "id", "digest"],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "approvedBy",
                "approvedAt",
                "expiresAt",
                "claims"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "outcomeId",
          "title",
          "objective",
          "dependsOn",
          "impactPath",
          "allowedPaths",
          "contextPaths"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "source",
    "productPath",
    "scenariosPath",
    "policyPath",
    "commit",
    "budget",
    "readyOutcomeId",
    "tasks"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/davidahmann/mill/schemas/change-request.schema.json",
  "title": "ChangeRequest"
}

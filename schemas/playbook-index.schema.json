{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "playbooks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["shared_migration_knowledge", "repository_procedure"]
          },
          "tags": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "path": {
            "type": "string",
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[^*?[\\]\\\\]+$"
          },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "required": [
          "id",
          "title",
          "summary",
          "kind",
          "tags",
          "path",
          "digest"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "playbooks"],
  "additionalProperties": false,
  "$id": "https://github.com/davidahmann/mill/schemas/playbook-index.schema.json",
  "title": "PlaybookIndex"
}

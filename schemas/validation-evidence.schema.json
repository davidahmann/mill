{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "candidateCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "verifierImage": {
      "type": "string",
      "pattern": "^[^@\\s]+@sha256:[a-f0-9]{64}$"
    },
    "network": { "type": "string", "const": "none" },
    "adaptation": {
      "type": "object",
      "properties": {
        "manifestDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "assurance": { "type": "string", "const": "offline_fixture_execution" },
        "ownerAcceptance": { "type": "string", "const": "not_recorded" },
        "provider": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "from": { "type": "string", "minLength": 1 },
            "to": { "type": "string", "minLength": 1 },
            "notice": {
              "type": "object",
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "required": ["path", "digest"],
              "additionalProperties": false
            }
          },
          "required": ["id", "from", "to", "notice"],
          "additionalProperties": false
        },
        "workflows": {
          "minItems": 1,
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "configurations": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "revision": { "type": "string", "minLength": 1 },
              "fixture": {
                "type": "object",
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                },
                "required": ["path", "digest"],
                "additionalProperties": false
              }
            },
            "required": ["id", "revision", "fixture"],
            "additionalProperties": false
          }
        },
        "fixtures": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["synthetic", "provider_recording"]
            },
            "capturedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          "required": ["kind", "capturedAt", "expiresAt"],
          "additionalProperties": false
        },
        "matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "workflowId": { "type": "string" },
              "configurationId": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["passed", "failed", "blocked", "excluded"]
              },
              "commandId": { "type": "string" },
              "scenarioId": { "type": "string" },
              "outputDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "reason": { "type": "string" }
            },
            "required": ["workflowId", "configurationId", "status"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "manifestDigest",
        "observedAt",
        "assurance",
        "ownerAcceptance",
        "provider",
        "configurations",
        "fixtures",
        "matrix"
      ],
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "commandId": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "blocked"]
          },
          "exitCode": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              { "type": "null" }
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "outputDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "reason": {
            "type": "string",
            "enum": [
              "HOST_EXECUTION_NOT_QUALIFIED",
              "CANCELLED",
              "DEADLINE_EXCEEDED",
              "OUTPUT_BUDGET_EXCEEDED",
              "NONZERO_EXIT"
            ]
          }
        },
        "required": [
          "commandId",
          "required",
          "status",
          "exitCode",
          "durationMs",
          "outputDigest"
        ],
        "additionalProperties": false
      }
    },
    "semantic": {
      "type": "object",
      "properties": {
        "impactManifestDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["acceptance", "invariant", "scenario"]
              },
              "id": { "type": "string", "minLength": 1 },
              "coverage": {
                "type": "string",
                "enum": ["new_behavior", "preservation", "both"]
              },
              "status": {
                "type": "string",
                "enum": ["passed", "attested", "blocked"]
              },
              "evidenceRefs": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "reason": { "type": "string", "minLength": 1 }
            },
            "required": ["kind", "id", "coverage", "status", "evidenceRefs"],
            "additionalProperties": false
          }
        },
        "newBehaviorPassed": { "type": "boolean" },
        "preservationPassed": { "type": "boolean" },
        "passed": { "type": "boolean" }
      },
      "required": [
        "impactManifestDigest",
        "items",
        "newBehaviorPassed",
        "preservationPassed",
        "passed"
      ],
      "additionalProperties": false
    },
    "passed": { "type": "boolean" }
  },
  "required": [
    "schemaVersion",
    "candidateCommit",
    "verifierImage",
    "network",
    "commands",
    "passed"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/davidahmann/mill/schemas/validation-evidence.schema.json",
  "title": "ValidationEvidence"
}
